{
	"name": "www",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "next dev -p 4444",
		"postinstall": "fumadocs-mdx",
		"build": "pnpm prebuild && next build",
		"build:registry": "npx tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-registry.ts && biome format --write public/r/*.json",
		"start": "next start",
		"lint": "biome lint",
		"check": "biome check",
		"fix": "biome check --write",
		"format": "biome format --write",
		"generate:demos": "npx tsx --tsconfig ./tsconfig.scripts.json ./scripts/generate-demo-registry.ts && biome check --write src/__registry__/demos.tsx",
		"generate:llms": "npx tsx --tsconfig ./tsconfig.scripts.json ./scripts/generate-llms/index.ts",
		"generate:globals-css": "npx tsx --tsconfig ./tsconfig.scripts.json ./scripts/generate-globals-css.ts && biome format --write public/r/globals.css",
		"prebuild": "pnpm generate:demos && pnpm generate:globals-css && pnpm generate:llms && pnpm build:registry"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@iconify/json": "^2.2.290",
		"@types/glob": "^8.1.0",
