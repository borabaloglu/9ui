		"lodash": "^4.17.21",
		"lucide-react": "^0.469.0",
		"match-sorter": "^8.1.0",
		"next": "16.4.5",
		"next-themes": "^0.4.4",
		"react": "^19.3.1",
		"react-day-picker": "^9.5.0",
