		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/strip-comments": "^2.0.4",
		"postcss": "^8",
		"prettier": "^3.2.5",
		"remark-gfm": "^4.0.0",
		"remark-mdx": "^3.1.0",
		"remark-parse": "^11.0.0",
		"typescript": "5.5.4",
		"unist-util-visit": "^5.0.0"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@hookform/resolvers": "^5.9.2",
		"@openpanel/nextjs": "^1.5.4",
		"@tailwindcss/postcss": "^4.1.7",
		"@tanstack/react-virtual": "^3.13.12",
		"@types/mdx": "^2.0.13",
		"@vercel/analytics": "^1.4.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk-base": "^1.0.0",
		"dayjs": "^1.11.13",
