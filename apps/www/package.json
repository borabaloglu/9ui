{
	"name": "www",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "next dev -p 4444",
		"postinstall": "fumadocs-mdx",
		"build": "pnpm prebuild && next build",
		"build:registry": "npx tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-registry.ts && biome format --write registry.json public/r/*.json",
		"start": "next start",
		"lint": "biome lint",
		"check": "biome check",
		"fix": "biome check --write",
		"format": "biome format --write",
		"generate:globals-css": "npx tsx --tsconfig ./tsconfig.scripts.json ./scripts/generate-globals-css.ts && biome format --write public/r/globals.css",
		"prebuild": "pnpm generate:globals-css && pnpm build:registry",
		"type-check": "tsc --noEmit",
		"clean": "rm -rf .next .source .turbo node_modules"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@types/node": "^20",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"postcss": "^8",
		"typescript": "5.5.4",
		"unist-util-visit": "^5.0.0"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@hookform/resolvers": "^5.9.2",
		"@openpanel/nextjs": "^1.5.4",
		"@tailwindcss/postcss": "^4.2.4",
		"@tanstack/react-form": "^1.28.5",
		"@tanstack/react-table": "^9.3.1",
		"@tanstack/react-virtual": "^3.13.12",
		"@types/mdx": "^2.0.13",
		"chrono-node": "^2.10.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"embla-carousel-react": "^8.5.2",
		"frimousse": "^0.4.0",
		"fumadocs-core": "16.18.3",
		"fumadocs-mdx": "15.5.2",
		"glob": "^11.0.1",
		"lucide-react": "^1.61.0",
		"match-sorter": "^8.1.0",
		"next": "16.4.5",
		"next-themes": "^0.4.4",
		"react": "^19.3.1",
		"react-day-picker": "^9.14.0",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.54.2",
		"react-phone-number-input": "^3.4.12",
		"react-resizable-panels": "^4.14.8",
		"recharts": "^3.10.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-pretty-code": "^0.14.0",
		"shiki": "^1.25.1",
		"sonner": "^2.0.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.4",
		"tw-animate-css": "^1.3.0",
		"unist-util-visit-parents": "^6.0.1",
		"vaul-base": "^1.0.0",
		"zod": "^4.6.7"
	}
