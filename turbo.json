{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**"],
			"env": ["CLIENT_ID"]
		},
		"build:registry": {
			"outputs": ["public/r/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"env": ["PORT"]
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"lint": {},
		"fix": {
			"cache": false
		},
		"format": {
			"cache": false
		},
		"check": {}
	}
}
